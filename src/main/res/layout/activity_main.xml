<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Underlying Bubble Cloud Launcher (Unchanged) -->
    <com.smartwatch.launcher.ui.BubbleCanvasView
        android:id="@+id/bubbleCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground Watch Face Container with Gestures and Customizer -->
    <com.smartwatch.launcher.ui.WatchFaceContainerView
        android:id="@+id/watchFaceContainerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>