<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 5-Theme Smartwatch App Listing Container -->
    <com.smartwatch.launcher.ui.themes.AppThemeContainerView
        android:id="@+id/appThemeContainerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground Watch Face Container (Swipes & 5 Dials) -->
    <com.smartwatch.launcher.ui.WatchFaceContainerView
        android:id="@+id/watchFaceContainerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>